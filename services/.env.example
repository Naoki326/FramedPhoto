# 服务端环境变量示例：cp .env.example .env 后按需修改
APP_HOST=0.0.0.0
APP_PORT=8000

# 设备默认尺寸（GDEB0709E01）
EPD_WIDTH=1200
EPD_HEIGHT=1600

# 上传文件存储目录
UPLOAD_DIR=./uploads

# OTA 固件存储目录
OTA_DIR=./ota

# SQLite 数据库文件
DB_PATH=./framedphoto.db

# --- AI 照片分析（VLM；留空则走启发式评分） ---
VLM_ENABLED=true
# 提供方：auto / openai / anthropic / disabled
# 当前配置为 OpenCodeGo（OpenAI 兼容接口）
VLM_PROVIDER=openai
# OpenAI 兼容接口地址（OpenCodeGo 的 API 端点，待填）
VLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
VLM_API_KEY=
VLM_MODEL=gpt-5.6-luna
VLM_TIMEOUT=600
VLM_API_MODE=responses
VLM_PROXY=http://127.0.0.1:7897

# Anthropic（Claude 视觉，VLM_PROVIDER=anthropic 或 auto 且有 key 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 每日精选 ---
# 照片库目录（tools/analyze_photos.py 扫描分析）
PHOTO_LIB_DIR=./photos
# 每日选片回忆度阈值（0-100）
DAILY_MIN_SCORE=55

# 日志级别
LOG_LEVEL=INFO
