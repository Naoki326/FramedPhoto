# 服务端环境变量示例：cp .env.example .env 后按需修改
APP_HOST=0.0.0.0
APP_PORT=8010

# 设备默认尺寸（GDEB0709E01）
EPD_WIDTH=1200
EPD_HEIGHT=1600

# 上传文件存储目录
UPLOAD_DIR=./uploads

# OTA 固件存储目录
OTA_DIR=./ota

# SQLite 数据库文件
DB_PATH=./framedphoto.db

# --- AI 照片分析（VLM；留空则走启发式评分） ---
VLM_ENABLED=true
# 提供方：auto / openai / anthropic / disabled
# 当前配置为 OpenCodeGo（OpenAI 兼容接口）
VLM_PROVIDER=openai
# OpenAI 兼容接口地址（OpenCodeGo 的 API 端点，待填）
VLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
VLM_API_KEY=
VLM_MODEL=gpt-5.6-luna
VLM_TIMEOUT=600
VLM_API_MODE=responses
VLM_PROXY=http://127.0.0.1:7897

# Anthropic（Claude 视觉，VLM_PROVIDER=anthropic 或 auto 且有 key 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 每日精选 ---
# 照片库目录（NAS photo 的本地镜像：同步 pull + 上传 push，ADR-0007）
PHOTO_LIB_DIR=./photos
# 每日选片回忆度阈值（0-100）
DAILY_MIN_SCORE=55

# --- 群晖 NAS（照片库主存储） ---
# rsync over SSH 增量同步（scripts/sync_nas.sh 定时/手动 pull；上传自动 push）
NAS_SSH_HOST=ds923
NAS_SSH_USER=root
NAS_SSH_PORT=22
NAS_PHOTO_DIR=/volume1/photo
NAS_RSYNC_PATH=/usr/local/bin/rsync   # 群晖需指向 synocli-net 的真实 rsync
NAS_RSYNC_BWLIMIT=100                  # 限速 KB/s（0 = 不限）

# 日志级别
LOG_LEVEL=INFO

# --- 时段编排（24h 三时段，HH:MM-HH:MM，支持跨天） ---
# SLOT_WEATHER=00:00-10:00    天气+日历卡片
# SLOT_PHOTO=10:00-21:00      每日照片
# SLOT_FREE=21:00-24:00       自由模块（LLM+文生图每日生成图文卡片）
SLOT_WEATHER=00:00-10:00
SLOT_PHOTO=10:00-21:00
SLOT_FREE=21:00-24:00
SLOT_WEATHER_ENABLED=true
SLOT_FREE_ENABLED=true

# --- 天气 API（默认和风天气，https://dev.qweather.com 注册；换厂家改 HOST） ---
# WEATHER_KEY=
# WEATHER_HOST=devapi.qweather.com      # 专属 Host（如 xxx.re.qweatherapi.com）
# WEATHER_LOCATION=101010100            # 城市 ID
# WEATHER_CITY=                         # 城市显示名（空 = IP 自动定位）

# --- 文本 LLM（自由模块文案 / 日历寄语 / 天气卡片设计） ---
# 按接口形态配置，不绑厂家：换厂家只改 BASE_URL / KEY / MODEL
# TEXT_API=openai                       # openai(/chat/completions) | anthropic(/v1/messages)
# TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TEXT_API_KEY=
# TEXT_MODEL=glm-4-flash

# --- 文生图（自由模块插画）：选择一种接口 ---
#   IMAGE_API=openai        → OpenAI 兼容图片接口（同步返回图）
#   IMAGE_API=signed_async  → 签名式异步任务接口（AK/SK，提交 + 轮询）
#   IMAGE_API=cloudflare    → Workers AI FLUX.1 schnell（失败不回退付费链路）
# IMAGE_API=openai
# IMAGE_API_URL=https://api.example.com/v1/images/generations
# IMAGE_API_KEY=
# IMAGE_MODEL=
# IMAGE_SIGNED_AK=                       # 签名式接口凭据
# IMAGE_SIGNED_SK=
# IMAGE_RATIO=4:3                        # 横屏（相框横放观看）
# CLOUDFLARE_ACCOUNT_ID=                 # Cloudflare 32 位十六进制账户 ID
# CLOUDFLARE_API_TOKEN=                  # Workers AI 专用 token，禁止提交真实值

# 旧键兼容：下列厂商名键仍能读到（新键优先），可逐步替换为上面中性键
# ZHIPU_API_KEY=          ZHIPU_MODEL=
# JIMENG_ACCESS_KEY=      JIMENG_SECRET_KEY=      JIMENG_RATIO=
# IMAGEGEN_URL=           IMAGEGEN_KEY=           IMAGEGEN_MODEL=
# QWEATHER_KEY=           QWEATHER_HOST=          QWEATHER_LOCATION=          QWEATHER_CITY=
