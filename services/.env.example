# 服务端环境变量示例：cp .env.example .env 后按需修改
APP_HOST=0.0.0.0
APP_PORT=8010

# 设备默认尺寸（GDEB0709E01）
EPD_WIDTH=1200
EPD_HEIGHT=1600

# 上传文件存储目录
UPLOAD_DIR=./uploads

# OTA 固件存储目录
OTA_DIR=./ota

# SQLite 数据库文件
DB_PATH=./framedphoto.db

# --- AI 照片分析（VLM；留空则走启发式评分） ---
VLM_ENABLED=true
# 提供方：auto / openai / anthropic / disabled
# 当前配置为 OpenCodeGo（OpenAI 兼容接口）
VLM_PROVIDER=openai
# OpenAI 兼容接口地址（OpenCodeGo 的 API 端点，待填）
VLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
VLM_API_KEY=
VLM_MODEL=gpt-5.6-luna
VLM_TIMEOUT=600
VLM_API_MODE=responses
VLM_PROXY=http://127.0.0.1:7897

# Anthropic（Claude 视觉，VLM_PROVIDER=anthropic 或 auto 且有 key 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 每日精选 ---
# 照片库目录（tools/analyze_photos.py 扫描分析）
# 局域网 SMB：指向挂载点，如 /Volumes/framedphoto-nas/photo
# 远程 IPv6：指向 rsync 同步目录（默认 ./photos）
PHOTO_LIB_DIR=./photos
# 每日选片回忆度阈值（0-100）
DAILY_MIN_SCORE=55

# --- 群晖 NAS ---
# 局域网直连：SMB 挂载（scripts/mount_nas.sh）
# NAS_HOST=
# NAS_SHARE=
# NAS_USER=
# NAS_PASSWORD=
# NAS_MOUNT_POINT=/Volumes/framedphoto-nas

# 远程 NAS（IPv6 公网）：rsync over SSH 增量同步（scripts/sync_nas.sh，推荐）
NAS_SSH_HOST=ds923
NAS_SSH_USER=root
NAS_SSH_PORT=22
NAS_PHOTO_DIR=/volume1/photo
NAS_RSYNC_PATH=/usr/local/bin/rsync   # 群晖需指向 synocli-net 的真实 rsync
NAS_RSYNC_BWLIMIT=100                  # 限速 KB/s（0 = 不限）

# 日志级别
LOG_LEVEL=INFO

# --- 时段编排（24h 三时段，HH:MM-HH:MM，支持跨天） ---
# SLOT_WEATHER=00:00-10:00    天气+日历卡片
# SLOT_PHOTO=10:00-21:00      每日照片
# SLOT_FREE=21:00-24:00       自由模块（LLM+文生图每日生成图文卡片）
SLOT_WEATHER=00:00-10:00
SLOT_PHOTO=10:00-21:00
SLOT_FREE=21:00-24:00
SLOT_WEATHER_ENABLED=true
SLOT_FREE_ENABLED=true

# --- 天气（和风天气，https://dev.qweather.com 注册） ---
# QWEATHER_KEY=
# QWEATHER_LOCATION=101010100   # 城市 ID，控制台可查

# --- 自由模块 LLM（智谱 GLM，https://open.bigmodel.cn 注册） ---
# 用于每天根据模块 prompt 生成当日内容（标题/正文/画面描述）；未配则只出插画/文字卡片
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-flash

# --- 自由模块插画（即梦 4.6 / 火山引擎视觉智能） ---
# JIMENG_ACCESS_KEY=
# JIMENG_SECRET_KEY=
# JIMENG_RATIO=4:3   # 横屏（相框横放观看）

# --- 文生图（OpenAI 图片接口兼容，如即梦/通义/DashScope 兼容模式） ---
# IMAGEGEN_URL=https://api.example.com/v1/images/generations
# IMAGEGEN_KEY=
# IMAGEGEN_MODEL=
