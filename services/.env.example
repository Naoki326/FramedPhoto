# 服务端环境变量示例：cp .env.example .env 后按需修改
APP_HOST=0.0.0.0
APP_PORT=8000

# 设备默认尺寸（GDEB0709E01）
EPD_WIDTH=1200
EPD_HEIGHT=1600

# 上传文件存储目录
UPLOAD_DIR=./uploads

# OTA 固件存储目录
OTA_DIR=./ota

# SQLite 数据库文件
DB_PATH=./framedphoto.db

# --- AI 照片分析（VLM，OpenAI 兼容接口；留空则走启发式评分） ---
VLM_ENABLED=true
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL=qwen3-vl-32b-instruct
VLM_TIMEOUT=600

# --- 每日精选 ---
# 照片库目录（tools/analyze_photos.py 扫描分析）
PHOTO_LIB_DIR=./photos
# 每日选片回忆度阈值（0-100）
DAILY_MIN_SCORE=55

# 日志级别
LOG_LEVEL=INFO
